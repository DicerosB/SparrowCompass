(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r250_120
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 120000)
            (height 250000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c45
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 22500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r250_120
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r250_120))
          (noconnect (pad r250_120))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r250_120))
          (noconnect (pad r250_120))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r250_120))
          (noconnect (pad r250_120))
        )
      )
      (padstack c45h90
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 45000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c45))
          (noconnect (pad c45))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c45))
          (noconnect (pad c45))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c45))
          (noconnect (pad c45))
        )
        (padSet (footLayer Inner)
          (clearance (pad c45))
          (connect (pad c45))
          (noconnect (pad c45))
        )
        (padSet (footLayer Bottom)
          (connect (pad c45))
          (noconnect (pad c45))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "JS102011SAQN"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
